    },
    "docker": {
      "title": "Docker Engine (Docker Hub pull-through mirrors)",
      "probe": {
        "path": "v2/",
        "ok_status": [200, 401],
        "expect": { "type": "any" },
        "max_bytes": 4096
      },
      "upstream": {
        "id": "dockerhub",
        "name": "Docker Hub (official)",
        "url": "https://registry-1.docker.io",
        "region": "global",
        "trust": "upstream",
        "evidence": ["https://habr.com/ru/articles/818299"],
        "confirmed": false,
        "notes": "Probe only checks that the registry API answers (200 or 401). It does not pull an image."
      },
      "mirrors": [
        {
          "id": "google-gcr-mirror",
          "name": "mirror.gcr.io (Google)",
          "url": "https://mirror.gcr.io",
          "region": "global",
          "trust": "vendor",
          "evidence": ["https://habr.com/ru/articles/818299"],
          "confirmed": false,
          "notes": "Caches popular Docker Hub images only."
        }
      ]
