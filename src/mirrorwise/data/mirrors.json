        {
          "id": "yandex-npm",
          "name": "Yandex public mirror",
          "url": "https://mirror.yandex.ru/npm/",
          "region": "RU",
          "trust": "vendor",
          "evidence": ["https://excalibra.github.io/2024/12-08/01"],
          "confirmed": false,
          "notes": "Single low-quality source. Probe decides."
        }
      ]
    },
    "go": {
      "title": "Go modules (GOPROXY)",
      "probe": {
        "path": "github.com/google/uuid/@v/list",
        "expect": { "type": "regex", "value": "(?m)^v\\d+\\.\\d+\\.\\d+" },
        "max_bytes": 65536
      },
      "upstream": {
        "id": "goproxy-official",
        "name": "proxy.golang.org (official)",
        "url": "https://proxy.golang.org",
        "region": "global",
        "trust": "upstream",
        "evidence": ["https://proxy.golang.org"],
        "confirmed": false,
        "notes": ""
      },
      "mirrors": [
        {
          "id": "goproxy-cn",
          "name": "goproxy.cn (Qiniu Cloud)",
          "url": "https://goproxy.cn",
          "region": "CN",
          "trust": "vendor",
          "evidence": ["https://goproxy.cn/"],
          "confirmed": false,
          "notes": "Go still verifies module hashes against GOSUMDB; if sum.golang.org is unreachable, see the README FAQ."
        },
        {
          "id": "aliyun-goproxy",
          "name": "Alibaba Cloud",
          "url": "https://mirrors.aliyun.com/goproxy/",
          "region": "CN",
          "trust": "vendor",
          "evidence": ["https://support.servbay.com/go/set-go-mirror"],
          "confirmed": false,
          "notes": ""
        },
        {
          "id": "goproxy-io",
          "name": "goproxy.io",
          "url": "https://goproxy.io",
          "region": "CN",
          "trust": "community",
          "evidence": ["https://support.servbay.com/go/set-go-mirror"],
          "confirmed": false,
