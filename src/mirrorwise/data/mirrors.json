{
  "schema_version": 1,
  "updated": "2026-11-17",
  "note": "Every entry is a CANDIDATE taken from public articles and mirror docs listed in 'evidence'. Nothing here was confirmed from a live network by the maintainers (confirmed=false). mirrorwise probes each URL on YOUR network before using it. Trust levels: upstream = the official registry; vendor = large operator or university; community = individual or unknown operator (off by default, needs --allow-community).",
  "ecosystems": {
    "pip": {
      "title": "pip / uv / Poetry (PyPI)",
      "probe": {
        "path": "pip/",
        "expect": { "type": "contains", "value": "pip" },
        "max_bytes": 262144
      },
      "upstream": {
        "id": "pypi",
        "name": "PyPI (official)",
        "url": "https://pypi.org/simple/",
        "region": "global",
        "trust": "upstream",
        "evidence": ["https://thecode.media/zerkalo-pypi/"],
        "confirmed": false,
        "notes": "pip first reads the index on pypi.org, then downloads files from files.pythonhosted.org. A mirror that does not rewrite file links still depends on the second host."
      },
      "mirrors": [
        {
          "id": "yandex-pypi",
          "name": "Yandex public mirror",
          "url": "https://mirror.yandex.ru/pypi/simple/",
          "region": "RU",
          "trust": "vendor",
          "evidence": ["https://skillbox.ru/media/code/v-rossii-sboil-pypi-osnovnoy-repozitoriy-paketov-dlya-python/"],
          "confirmed": false,
          "notes": "Path as given in a Skillbox Media article (June 2026)."
        },
        {
          "id": "yandex-pypi-alt",
          "name": "Yandex public mirror (alternative path)",
          "url": "https://mirror.yandex.ru/mirrors/pypi/simple/",
          "region": "RU",
          "trust": "vendor",
          "evidence": ["https://excalibra.github.io/2024/12-08/01"],
          "confirmed": false,
          "notes": "Single low-quality source that disagrees with the path above. Kept so that the probe can decide which one is alive."
        },
        {
          "id": "tuna-pypi",
          "name": "Tsinghua University TUNA",
          "url": "https://pypi.tuna.tsinghua.edu.cn/simple/",
          "region": "CN",
          "trust": "vendor",
          "evidence": [
            "https://thecode.media/zerkalo-pypi/",
            "https://skillbox.ru/media/code/v-rossii-sboil-pypi-osnovnoy-repozitoriy-paketov-dlya-python/"
          ],
          "confirmed": false,
          "notes": "University mirror. Use hash-pinned lock files (pip --require-hashes)."
        },
        {
          "id": "aliyun-pypi",
          "name": "Alibaba Cloud",
          "url": "https://mirrors.aliyun.com/pypi/simple/",
          "region": "CN",
          "trust": "vendor",
          "evidence": [
            "https://skillbox.ru/media/code/v-rossii-sboil-pypi-osnovnoy-repozitoriy-paketov-dlya-python/",
            "https://excalibra.github.io/2024/12-08/01"
          ],
          "confirmed": false,
          "notes": "The 2024 blog lists the http:// form; https:// is used here."
        },
        {
          "id": "depkit-pypi",
          "name": "pypi.depkit.ru",
          "url": "https://pypi.depkit.ru/simple/",
          "region": "RU",
          "trust": "community",
          "evidence": ["https://habr.com/ru/articles/1043976/"],
          "confirmed": false,
          "notes": "Hosted by a third party, no source repository was linked in the article. Off by default."
        }
      ]
    },
    "npm": {
      "title": "npm / pnpm / Yarn classic",
      "probe": {
        "path": "left-pad",
        "accept": "application/vnd.npm.install-v1+json",
        "expect": { "type": "regex", "value": "\"name\"\\s*:\\s*\"left-pad\"" },
        "max_bytes": 262144
      },
      "upstream": {
        "id": "npmjs",
        "name": "npm registry (official)",
        "url": "https://registry.npmjs.org/",
        "region": "global",
        "trust": "upstream",
        "evidence": ["https://gac.bytenote.net/tips/npm-china-mirror"],
        "confirmed": false,
        "notes": ""
      },
      "mirrors": [
