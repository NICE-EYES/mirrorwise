    "cargo": {
      "title": "Cargo (crates.io sparse index)",
      "probe": {
        "path": "config.json",
        "expect": { "type": "json_key", "value": "dl" },
        "max_bytes": 16384
      },
      "upstream": {
        "id": "crates-io",
        "name": "crates.io (official sparse index)",
        "url": "sparse+https://index.crates.io/",
        "region": "global",
        "trust": "upstream",
        "evidence": [],
        "confirmed": false,
        "notes": "Default sparse index of crates.io, see the Cargo reference (registry index). No fetched source in the research report."
      },
      "mirrors": [
        {
          "id": "tuna-crates",
          "name": "Tsinghua University TUNA",
          "url": "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/",
          "region": "CN",
          "trust": "vendor",
          "evidence": ["https://mirrors-i.tuna.tsinghua.edu.cn/help/crates.io-index/"],
          "confirmed": false,
