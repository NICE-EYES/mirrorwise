          "region": "CN",
          "trust": "vendor",
          "evidence": ["https://mirrors.hust.edu.cn/en/docs/crates/"],
          "confirmed": false,
          "notes": ""
        },
        {
          "id": "rsproxy",
          "name": "rsproxy.cn",
          "url": "sparse+https://rsproxy.cn/index/",
          "region": "CN",
          "trust": "vendor",
